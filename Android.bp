soong_namespace {
}

filegroup {
    name: "sensors_iio_srcs",
    srcs: [
        "accel-calibration.c",
        "compass-calibration.c",
        "control.c",
        "description.c",
        "discovery.c",
        "entry.c",
        "enumeration.c",
        "filtering.c",
        "gyro-calibration.c",
        "matrix-ops.c",
        "transform.c",
        "utils.c",
    ],
}

filegroup {
    name: "activity_iio_srcs",
    srcs: [
        "activity_event_entry.c",
        "discovery.c",
        "utils.c",
    ],
}

cc_defaults {
    name: "intel_sensors_iio_cc_defaults",
    cflags: [
        "-fvisibility=hidden",
    ],
    header_libs: [
        "libhardware_headers",
        "libutils_headers",
    ],
    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
    ],
    vendor: true,
}

cc_defaults {
    name: "intel_sensors_iio_hal_cc_defaults",
    defaults: ["intel_sensors_iio_cc_defaults"],
    relative_install_path: "hw",
    cflags: [
        "-Wno-missing-field-initializers",
    ],
    ldflags: [
        "-Wl,--gc-sections",
    ],
}

cc_library_shared {
    name: "sensors.iio",
    defaults: ["intel_sensors_iio_hal_cc_defaults"],
    cflags: [
        "-DLOG_TAG=\"Sensors\"",
    ] + select(soong_config_variable("intel_sensors_iio", "use_libhwdb_sensor"), {
        true: ["-DUSE_LIBHWDB_SENSOR"],
        default: [],
    }),
    static_libs: select(soong_config_variable("intel_sensors_iio", "use_libhwdb_sensor"), {
        true: ["libhwdb_sensor", "libsmbios_parser"],
        default: [],
    }),
    srcs: [":sensors_iio_srcs"],
}

cc_binary {
    name: "sens",
    defaults: ["intel_sensors_iio_cc_defaults"],
    cflags: ["-DLOG_TAG=\"Sensors\""],
    srcs: ["sens.c"],
}

cc_library_shared {
    name: "activity.iio",
    defaults: ["intel_sensors_iio_hal_cc_defaults"],
    cflags: ["-DLOG_TAG=\"Activity\""],
    srcs: [":activity_iio_srcs"],
}

cc_binary {
    name: "activity",
    defaults: ["intel_sensors_iio_cc_defaults"],
    cflags: ["-DLOG_TAG=\"Activity\""],
    srcs: ["activity.c"],
}
